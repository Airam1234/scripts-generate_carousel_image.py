# Copy to .env (never commit it) or set these in your cloud host's settings.
APP_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://user:password@host:5432/registers
BASE_URL=https://registers.example.org
ORGANISATION_NAME=Your Training Provider
TRUST_PROXY=1

# Pastoral alerts
PASTORAL_GRACE_MINUTES=15
PASTORAL_EMAIL=pastoral@example.org
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=registers@example.org
SMTP_PASSWORD=
MAIL_FROM=registers@example.org

# Policy
ATTENDANCE_THRESHOLD=90
IDLE_TIMEOUT_MINUTES=30
TUTOR_EDIT_WINDOW_DAYS=7
